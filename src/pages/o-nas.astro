---
import Layout from "../layouts/Layout.astro";
import ContactSidebar from "../components/ContactSidebar.astro";

const logopeds = [
    {
        name: "PhDr. Markéta Terezia Pavlíková",
        title: "odborný garant a klinický logoped",
        experience: [
            "praxe od roku 2009 – Ambulance klinické logopedie v Městské nemocnici v Litoměřicích",
            "práce s širokým spektrem pacientů, práce s dospělými i dětskými klienty v ambulanci a na lůžkových odděleních nemocnice",
            "oddělení rehabilitace, interní oddělení, LDN, neurologie, ORL, ARO a JIP",
            "2015 – atestace v oboru klinická logopedie – Ministerstvo zdravotnictví",
            "2015 – osvědčení k výkonu zdravotnického povolání bez odborného dohledu v oboru klinický logoped – Ministerstvo zdravotnictví",
            "2015 – zvláštní kvalifikace pro úhradu výkonů K-3 – Asociace klinických logopedů",
            "2019 – rigorózní zkouška a rigorózní práce na téma: Logopedická intervence u dospělých osob s demencí",
        ],
        courses: [
            "dyslalie",
            "ADHD",
            "vývojová dyslalie",
            "poruchy polykaní u dětí",
            "afazologie A a B",
            "afazie 1 a 2",
            "hlas",
            "incipientní koktavost",
            "klinická neurologie",
            "neurogenní poruchy komunikace u dospělých pacientů",
            "vady a poruchy sluchu",
            "vyšetřovací testy v klinické logopedii",
        ],
        phone: "+420 603 110 072",
        phoneHref: "tel:+420603110072",
        email: "marketa.pavlikova@logopedieandel.cz",
        emailHref: "mailto:marketa.pavlikova@logopedieandel.cz",
    },
    {
        name: "Mgr. Jana Nováková",
        title: "klinický logoped",
        experience: [
            "praxe od roku 20##",
            "specializace na dětskou logopedie",
            "20## – atestace v oboru klinická logopedie",
        ],
        courses: [
            "kurz 1",
            "kurz 2",
            "kurz 3",
        ],
        phone: "+420 000 000 000",
        phoneHref: "tel:+420000000000",
        email: "jana.novakova@logopedieandel.cz",
        emailHref: "mailto:jana.novakova@logopedieandel.cz",
    },
    {
        name: "Mgr. Petra Svobodová",
        title: "logopedický asistent",
        experience: [
            "praxe od roku 20##",
            "zkušenosti s předškolními dětmi",
        ],
        courses: [
            "kurz 1",
            "kurz 2",
            "kurz 3",
        ],
        phone: "+420 000 000 000",
        phoneHref: "tel:+420000000000",
        email: "petra.svobodova@logopedieandel.cz",
        emailHref: "mailto:petra.svobodova@logopedieandel.cz",
    },
];
---

<Layout title="O nás | Logopedie Anděl">
    <div class="flex flex-col md:flex-row relative">
        <section
            aria-labelledby="page-heading"
            class="flex-1 px-5 md:px-8 py-12 md:pr-14 min-h-[500px]"
        >
            <h1
                id="page-heading"
                class="text-2xl text-brand-blue pb-8 leading-snug"
            >
                O nás
            </h1>

            <div class="flex flex-col gap-6 max-w-xl">
                {logopeds.map((logoped, i) => (
                    <article class="border border-gray-200 rounded-lg overflow-hidden flex flex-col cursor-pointer select-none logoped-card">
                        <div class="h-1 bg-brand-blue w-full"></div>
                        <div class="p-5 flex flex-col flex-1">
                            <div class="flex items-start justify-between gap-2 mb-1">
                                <strong class="font-semibold text-brand-blue text-base block leading-snug">
                                    {logoped.name}
                                </strong>
                                <span class="chevron text-brand-gray text-lg transition-transform mt-0.5 shrink-0" style={i === 0 ? 'transform: rotate(90deg)' : ''}>›</span>
                            </div>
                            <p class="text-xs text-brand-gray mb-4 uppercase tracking-wide">{logoped.title}</p>

                            <div class={`collapsible${i === 0 ? '' : ' hidden'}`}>
                                <p class="text-xs font-semibold text-brand-gray uppercase tracking-wide mb-1">Zkušenosti</p>
                                <ul class="font-light text-sm space-y-1.5 text-brand-gray list-disc ml-5 mb-4">
                                    {logoped.experience.map((item) => (
                                        <li>{item}</li>
                                    ))}
                                </ul>

                                <p class="text-xs font-semibold text-brand-gray uppercase tracking-wide mb-2">Specializační kurzy</p>
                                <div class="flex flex-wrap gap-1.5 mb-4">
                                    {logoped.courses.map((course) => (
                                        <span class="bg-gray-100 text-brand-gray text-xs px-2 py-0.5 rounded-full">
                                            {course}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            <div class="mt-auto pt-4 border-t border-gray-100 text-sm space-y-1">
                                <a
                                    href={logoped.phoneHref}
                                    class="block text-brand-gray hover:text-brand-blue transition-colors"
                                    onclick="event.stopPropagation()"
                                >
                                    {logoped.phone}
                                </a>
                                <a
                                    href={logoped.emailHref}
                                    class="block text-brand-gold font-semibold hover:text-brand-blue transition-colors break-all"
                                    onclick="event.stopPropagation()"
                                >
                                    {logoped.email}
                                </a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <ContactSidebar />
    </div>
</Layout>

<script>
    document.querySelectorAll('.logoped-card').forEach((card) => {
        card.addEventListener('click', () => {
            const content = card.querySelector('.collapsible') as HTMLElement;
            const chevron = card.querySelector('.chevron') as HTMLElement;
            const isOpen = !content.classList.contains('hidden');
            content.classList.toggle('hidden', isOpen);
            chevron.style.transform = isOpen ? '' : 'rotate(90deg)';
        });
    });
</script>
