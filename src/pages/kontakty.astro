---
import Layout from "../layouts/Layout.astro";
import ContactSidebar from "../components/ContactSidebar.astro";
---

<Layout title="Kontakty | Logopedie Anděl">
    <div class="flex flex-col md:flex-row relative">
        <div class="flex-1 px-5 md:px-8 py-12 md:pr-14 min-h-[500px] mb-10">
            <h1
                class="text-2xl font-semibold text-brand-blue pb-10 md:w-[400px] leading-snug"
            >
                Kontakty
            </h1>

            <div>
                <p class="text-sm pb-4">
                    Ambulance se nachází v budově Ženské domovy, Ostrovského
                    253/3, Praha 5, 150 00 ve 2. patře – dveře číslo 2064 a
                    2065.
                </p>

                <p class="text-sm pb-4">
                    telefon: +420 735 123 348, +420 736 198 769<br />
                    <a
                        href="mailto:info@logopedieandel.cz"
                        class="text-brand-gold font-bold no-underline hover:text-brand-blue"
                        >info@logopedieandel.cz</a
                    ><br /><br />
                </p>

                <p class="text-sm pb-4">
                    <strong class="font-bold text-base"
                        >Jak se k nám dostanete:</strong>
                </p>
                <p class="text-sm pb-4">
                    Metro – trasa B – stanice Anděl – výstup směr Na Knížecí a
                    Ženské domovy
                </p>
                <p class="text-sm pb-4">Tramvaj č. 7 – zastávka Radlická</p>
                <p class="text-sm pb-4">
                    Autobusy č. 231, 137, 167, 191, 120 – zastávka Na Knížecí
                </p>
                <p class="text-sm pb-4">
                    Autem – možnost parkovat zdarma 3 hodiny v OC Nový Smíchov
                    nebo na hlídaném parkovišti za Ženskými domovy
                </p>
                <p class="text-sm pb-4">Budova má bezbariérový přístup.</p>
            </div>

            <br /><br />

            <div
                class="relative pb-[65.25%] h-0 overflow-auto touch-pan-scroll"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2560.942882406652!2d14.400577616041268!3d50.068631322683196!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470b945723b9cd95%3A0xa6e66939b6cd83ac!2sOstrovsk%C3%A9ho+253%2F3%2C+150+00+Praha+5-Sm%C3%ADchov!5e0!3m2!1scs!2scz!4v1486764660478"
                    class="absolute top-0 left-0 w-full h-full pointer-events-none border-0"
                    allowfullscreen></iframe>
            </div>
        </div>

        <div class="md:mt-[428px]">
            <ContactSidebar />
        </div>
    </div>
</Layout>
