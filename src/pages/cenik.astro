---
import Layout from "../layouts/Layout.astro";
import ContactSidebar from "../components/ContactSidebar.astro";
---

<Layout title="Ceník | Logopedie Anděl">
    <div class="flex flex-col md:flex-row relative">
        <section
            aria-labelledby="page-heading"
            class="flex-1 px-5 md:px-8 py-12 md:pr-14 min-h-[500px]"
        >
            <h1
                id="page-heading"
                class="text-2xl text-brand-blue pb-8 md:w-[400px] leading-snug"
            >
                Ceník
            </h1>

            <p class="pb-6">
                <strong class="font-semibold text-brand-blue text-base"
                    >Naše logopedická ambulance má uzavřenou smlouvu se
                    Všeobecnou zdravotní pojišťovnou (111), pojišťovnou VoZP
                    (201), ČPZP (205), OZP (207), ZPŠ (209), ZP MV (211) a RBP
                    (213).</strong
                >
            </p>

            <p class="text-sm text-brand-gray font-semibold pb-4">Logopedie:</p>

            <table class="w-full text-sm">
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Vstupní logopedické vyšetření (max. 60 min, délka
                        závisí na problematice)</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >1 200 Kč</td
                    >
                </tr>
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Logopedie 30 min.</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >600 Kč</td
                    >
                </tr>
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Logopedie 45 min.</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >900 Kč</td
                    >
                </tr>
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Logopedie 60 min.</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >1 200 Kč</td
                    >
                </tr>
            </table>

            <p class="text-sm text-brand-gray pb-4">
                Nutnou délku logopedické terapie budeme znát po absolvování
                vstupního vyšetření.
            </p>

            <p class="text-sm text-brand-gray pb-4 mt-6">
                <b class="font-bold block"
                    >Ceny platné pro všechny klienty (výkony nejsou hrazeny
                    zdravotní pojišťovnou):</b
                >
            </p>

            <table class="w-full text-sm">
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Vyšetření řeči a potvrzení na přihlášku k VŠ studiu</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >500 Kč</td
                    >
                </tr>
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Logopedická zpráva na vyžádání u pravidelně
                        docházejících klientů</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >500 Kč</td
                    >
                </tr>
                <tr>
                    <th
                        scope="row"
                        class="pb-4 font-semibold text-brand-blue text-left"
                        >Logopedická zpráva na vyžádání po jednorázové návštěvě</th
                    >
                    <td
                        class="pb-4 text-right text-brand-gray whitespace-nowrap pl-4"
                        >1 500 Kč</td
                    >
                </tr>
            </table>

            <p class="text-sm text-brand-gray pb-4">
                <b class="font-bold block pt-6">Způsob platby:</b>
            </p>
            <ul class="list-disc text-brand-gray ml-4 text-sm">
                <li class="pl-0 pb-5">v hotovosti v ambulanci</li>
                <li class="pl-0 pb-5">
                    bankovních převodem na účet ambulance: 2601074397/2010<br
                    />(Do poznámky uveďte jméno klienta a datum návštěvy.)
                </li>
            </ul>
        </section>

        <ContactSidebar />
    </div>
</Layout>
