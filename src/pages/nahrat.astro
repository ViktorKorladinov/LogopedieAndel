---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import ContactSidebar from "../components/ContactSidebar.astro";
import { Resend } from "resend";

let success = false;
let error = "";

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const name = data.get("name")?.toString() || "";
        const email = data.get("email")?.toString() || "";
        const message = data.get("message")?.toString() || "";
        const file = data.get("file");

        if (!name || !email) {
            error = "Jméno a e-mail jsou povinné.";
        } else {
            const resendApiKey =
                import.meta.env.RESEND_API_KEY || "re_123456789";
            const resend = new Resend(resendApiKey);

            const attachments = [];
            if (file && file instanceof File && file.size > 0) {
                const arrayBuffer = await file.arrayBuffer();

                // Zpracování do Bufferu přes node:buffer, které je běžně podporováno u většiny adaptérů včetně CF (s node compat)
                // Alternativou je posílat jako base64 řetězec, který resend také podporuje.
                const { Buffer } = await import("node:buffer");
                const content = Buffer.from(arrayBuffer);

                attachments.push({
                    filename: file.name,
                    content: content,
                });
            }

            await resend.emails.send({
                from: "Nahrání Formuláře <onboarding@resend.dev>", // Uživatel by si zde měl nastavit vlastní verifikovanou doménu
                to: ["your-email@example.com"], // Zde nastavte Váš reálný e-mail
                subject: `Nový formulář od: ${name}`,
                html: `<p><strong>Jméno:</strong> ${name}</p>
               <p><strong>E-mail:</strong> ${email}</p>
               <p><strong>Zpráva:</strong> ${message}</p>`,
                attachments,
            });
            success = true;
        }
    } catch (e) {
        if (e instanceof Error) {
            error = e.message;
        } else {
            error = "Došlo k neznámé chybě.";
        }
    }
}
---

<Layout title="Nahrát formulář | Logopedie Anděl">
    <div class="flex flex-col md:flex-row relative">
        <div class="flex-1 px-5 md:px-8 py-12 md:pr-14 min-h-[500px]">
            <h1 class="text-2xl text-brand-blue pb-5 md:w-[400px] leading-snug">
                Nahrát formulář
            </h1>

            <p
                class="text-lg text-brand-gray leading-snug pb-5 md:max-w-[400px]"
            >
                Zde nám můžete bezpečně zaslat vyplněné formuláře nebo jiné
                dokumenty.
            </p>

            {
                success && (
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
                        Formulář byl úspěšně odeslán. Děkujeme!
                    </div>
                )
            }

            {
                error && (
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
                        {error}
                    </div>
                )
            }

            {
                !success && (
                    <form
                        method="POST"
                        enctype="multipart/form-data"
                        class="max-w-[500px] flex flex-col gap-4"
                    >
                        <div>
                            <label
                                for="name"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                Jméno a příjmení *
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                E-mail *
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <div>
                            <label
                                for="message"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                Zpráva
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <div>
                            <label
                                for="file"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                Vyberte soubor (formulář)
                            </label>
                            <input
                                type="file"
                                id="file"
                                name="file"
                                class="w-full border border-brand-gray p-2"
                            />
                        </div>

                        <button
                            type="submit"
                            class="bg-brand-gold text-white font-bold py-3 mt-4 w-[200px] text-center hover:bg-brand-blue transition-colors"
                        >
                            ODESLAT
                        </button>
                        <p class="text-xs text-brand-gray mt-2">
                            * Povinné položky
                        </p>
                    </form>
                )
            }
        </div>

        <ContactSidebar />
    </div>
</Layout>
