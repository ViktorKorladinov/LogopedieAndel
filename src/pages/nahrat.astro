---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import ContactSidebar from "../components/ContactSidebar.astro";
import { Resend } from "resend";
import Turnstile from "../components/Turnstile.astro";

let success = false;
let error = "";

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const name = data.get("name")?.toString() || "";
        const email = data.get("email")?.toString() || "";
        const message = data.get("message")?.toString() || "";
        const token = data.get("cf-turnstile-response")?.toString();

        if (!name || !email) {
            error = "Jméno a e-mail jsou povinné.";
        } else if (!token) {
            error =
                "Ověření proti botům selhalo. Prosím, potvrďte, že nejste robot.";
        } else {
            const runtime = Astro.locals.runtime || {};
            const env = runtime.env || {};

            const secretKey =
                env.TURNSTILE_SECRET_KEY ||
                import.meta.env.TURNSTILE_SECRET_KEY ||
                process.env.TURNSTILE_SECRET_KEY;

            // Validate the token with Cloudflare
            const verifyResponse = await fetch(
                "https://challenges.cloudflare.com/turnstile/v0/siteverify",
                {
                    method: "POST",
                    body: JSON.stringify({
                        secret: secretKey,
                        response: token,
                    }),
                    headers: { "Content-Type": "application/json" },
                },
            );

            const verification = await verifyResponse.json();

            if (verification.success) {
                // Token is valid, call Resend
                const resendApiKey =
                    env.RESEND_API_KEY ||
                    import.meta.env.RESEND_API_KEY ||
                    process.env.RESEND_API_KEY;
                const formEmailTo =
                    env.FORM_EMAIL_TO ||
                    import.meta.env.FORM_EMAIL_TO ||
                    process.env.FORM_EMAIL_TO;

                if (!resendApiKey || !formEmailTo) {
                    error = "Chyba serveru, zkuste to prosím později.";
                } else {
                    const resend = new Resend(resendApiKey);

                    const response = await resend.emails.send({
                        from: "onboarding@resend.dev",
                        to: [formEmailTo],
                        subject: `Nová zpráva od: ${name}`,
                        html: `<p><strong>Jméno:</strong> ${name}</p>
                   <p><strong>E-mail:</strong> ${email}</p>
                   <p><strong>Zpráva:</strong> ${message}</p>`,
                    });

                    if (response.error) {
                        error = `Nepodařilo se odeslat email: ${response.error.message}`;
                    } else {
                        success = true;
                    }
                }
            } else {
                // Fail! Likely a bot.
                error = "Ověření proti botům selhalo. Zkuste to prosím znovu.";
            }
        }
    } catch (e) {
        if (e instanceof Error) {
            error = e.message;
        } else {
            error = "Došlo k neznámé chybě.";
        }
    }
}
---

<Layout title="Napsat nám | Logopedie Anděl">
    <div class="flex flex-col md:flex-row relative">
        <section
            aria-labelledby="page-heading"
            class="flex-1 px-5 md:px-8 py-12 md:pr-14 min-h-[500px]"
        >
            <h1
                id="page-heading"
                class="text-2xl text-brand-blue pb-5 md:w-[400px] leading-snug"
            >
                Napsat nám
            </h1>

            <p
                class="text-lg text-brand-gray leading-snug pb-5 md:max-w-[400px]"
            >
                Zde nám můžete zanechat zprávu a my se Vám v co nejkratší době
                ozveme zpět.
            </p>

            {
                success && (
                    <div
                        role="alert"
                        class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4"
                    >
                        Zpráva byla úspěšně odeslána. Děkujeme!
                    </div>
                )
            }

            {
                error && (
                    <div
                        role="alert"
                        class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4"
                    >
                        {error}
                    </div>
                )
            }

            {
                !success && (
                    <form
                        method="POST"
                        class="max-w-[500px] flex flex-col gap-4"
                    >
                        <div>
                            <label
                                for="name"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                Jméno a příjmení *
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                aria-required="true"
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                E-mail *
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                aria-required="true"
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <div>
                            <label
                                for="message"
                                class="block text-brand-blue font-semibold mb-1"
                            >
                                Zpráva
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                class="w-full border border-brand-gray p-2 focus:outline-none focus:border-brand-blue"
                            />
                        </div>
                        <Turnstile />
                        <button
                            type="submit"
                            class="bg-brand-gold text-white font-bold py-3 mt-4 w-[200px] text-center hover:bg-brand-blue transition-colors"
                        >
                            ODESLAT
                        </button>
                        <p class="text-xs text-brand-gray mt-2">
                            * Povinné položky
                        </p>
                    </form>
                )
            }
        </section>

        <ContactSidebar />
    </div>
</Layout>
