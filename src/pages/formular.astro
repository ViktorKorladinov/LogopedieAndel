---
import Layout from "../layouts/Layout.astro";
import Turnstile from "../components/Turnstile.astro";
import { handlePatientForm } from "../utils/formHandler";

export const prerender = false;

let success = false;
let error = "";

if (Astro.request.method === "POST") {
    const result = await handlePatientForm(Astro.request, Astro.locals);
    success = result.success;
    error = result.error || "";
}
---

<Layout title="Dokumentace pacienta | Logopedie Anděl" hideBackground={true}>
    <div class="min-h-screen bg-stone-100 py-12 px-4 font-sans">
        <div class="max-w-5xl mx-auto">

            <!-- Card -->
            <div class="bg-white shadow-sm rounded-sm overflow-hidden">

                <!-- Header -->
                <div class="bg-brand-blue px-10 py-10 relative overflow-hidden">
                    <div class="absolute -bottom-16 -right-16 w-56 h-56 rounded-full bg-white opacity-[0.04]"></div>
                    <p class="text-[#7a9cc4] text-xs font-semibold tracking-[0.2em] uppercase mb-3">
                        Logopedie Anděl &mdash; vzor LA-2026/A
                    </p>
                    <h1 class="text-white text-5xl sm:text-6xl font-light leading-tight mb-2" style="font-family: Georgia, serif;">
                        Záznam <em>o pacientovi</em>
                    </h1>
                    <p class="text-[#7a9cc4] text-sm font-light tracking-wide">
                        Vstupní logopedické vyšetření a anamnéza
                    </p>
                </div>

                {success && (
                    <div role="alert" class="mx-8 mt-6 border-l-4 border-emerald-600 bg-emerald-50 px-6 py-5 text-emerald-800 text-base font-medium rounded-sm">
                        Dokument byl úspěšně zaregistrován. Budeme vás kontaktovat na uvedenou e-mailovou adresu. Děkujeme.
                    </div>
                )}

                {error && (
                    <div role="alert" class="mx-8 mt-6 border-l-4 border-red-600 bg-red-50 px-6 py-5 rounded-sm">
                        <strong class="block text-xs font-semibold tracking-[0.12em] uppercase text-red-700 mb-1">Systémová chyba</strong>
                        <span class="text-red-800 text-base">{error}</span>
                    </div>
                )}

                {!success && (
                    <form method="POST">

                        <!-- Section I -->
                        <div class="flex items-center gap-4 px-10 py-4 bg-stone-50 border-y border-stone-200">
                            <div class="w-6 h-6 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">I</div>
                            <span class="text-xs font-semibold tracking-[0.16em] uppercase text-brand-blue">Osobní údaje pacienta</span>
                        </div>

                        <div class="px-10 py-7 grid gap-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div class="flex flex-col gap-2">
                                    <label for="name" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Jméno a příjmení <span class="text-red-500">*</span>
                                    </label>
                                    <input
                                        type="text" id="name" name="name" required
                                        placeholder="Celé jméno pacienta"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="rc" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Rodné číslo
                                    </label>
                                    <input
                                        type="text" id="rc" name="Rodné číslo"
                                        placeholder="xxxxxx/xxxx"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium font-mono placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                                <div class="flex flex-col gap-2 sm:col-span-2">
                                    <label for="address" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Adresa trvalého bydliště
                                    </label>
                                    <input
                                        type="text" id="address" name="Adresa bydliště"
                                        placeholder="Ulice, město, PSČ"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="insurance" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Zdravotní pojišťovna
                                    </label>
                                    <input
                                        type="text" id="insurance" name="Zdravotní pojišťovna"
                                        placeholder="např. 111"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium font-mono placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                            </div>
                        </div>

                        <!-- Section II -->
                        <div class="flex items-center gap-4 px-10 py-4 bg-stone-50 border-y border-stone-200">
                            <div class="w-6 h-6 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">II</div>
                            <span class="text-xs font-semibold tracking-[0.16em] uppercase text-brand-blue">Kontaktní údaje a zákonný zástupce</span>
                        </div>

                        <div class="px-10 py-7 grid gap-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div class="flex flex-col gap-2">
                                    <label for="guardian" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Zákonný zástupce
                                    </label>
                                    <input
                                        type="text" id="guardian" name="Zákonný zástupce"
                                        placeholder="Jméno a příjmení (u dětí)"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="phone" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Telefonní spojení
                                    </label>
                                    <input
                                        type="tel" id="phone" name="Telefon"
                                        placeholder="+420 000 000 000"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium font-mono placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div class="flex flex-col gap-2">
                                    <label for="email" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                        Kontaktní e-mail <span class="text-red-500">*</span>
                                    </label>
                                    <input
                                        type="email" id="email" name="email" required
                                        placeholder="priklad@email.cz"
                                        class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                    />
                                    <span class="text-xs text-slate-400 font-medium">Na tento e-mail zasíláme veškerou komunikaci.</span>
                                </div>
                                <div class="flex flex-col justify-end">
                                    <label for="consent" class="flex items-start gap-3 bg-white border-2 border-slate-300 rounded-sm p-4 cursor-pointer hover:border-slate-400 hover:bg-slate-50 transition-all group">
                                        <input
                                            type="checkbox" id="consent" name="Souhlas se zpracovanim" required
                                            class="mt-1 w-5 h-5 rounded-sm border-slate-300 accent-brand-blue flex-shrink-0 cursor-pointer"
                                        />
                                        <span class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors">
                                            Souhlasím se zpracováním <strong class="text-brand-blue font-semibold">osobních údajů</strong> pro účely objednání a vedení zdravotnické dokumentace <span class="text-red-500">*</span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Section III -->
                        <div class="flex items-center gap-4 px-10 py-4 bg-stone-50 border-y border-stone-200">
                            <div class="w-6 h-6 rounded-full bg-brand-blue flex items-center justify-center text-white text-xs font-bold flex-shrink-0">III</div>
                            <span class="text-xs font-semibold tracking-[0.16em] uppercase text-brand-blue">Anamnéza a důvod vyšetření</span>
                        </div>

                        <div class="px-10 py-7 grid gap-6">
                            <div class="flex flex-col gap-2">
                                <label for="reason" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                    Hlavní důvod žádosti o vyšetření
                                </label>
                                <textarea
                                    id="reason" name="Důvod vyšetření" rows="2"
                                    placeholder="Stručně popište obtíže nebo důvod návštěvy"
                                    class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
                                />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="history" class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
                                    Základní lékařská a rodinná anamnéza
                                </label>
                                <span class="text-xs text-slate-400 font-medium -mt-1">Přidružená onemocnění, komplikace při porodu, vývoj řeči, rodinná zátěž</span>
                                <textarea
                                    id="history" name="Anamnéza" rows="5"
                                    placeholder="Volný popis…"
                                    class="bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue text-base font-medium placeholder-slate-400 outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all resize-y"
                                ></textarea>
                            </div>
                        </div>

                        <!-- Submit -->
                        <div class="border-t border-stone-100 bg-stone-50 px-10 py-8 flex flex-col items-center gap-5">
                            <div class="flex justify-center">
                                <Turnstile />
                            </div>
                            <button
                                type="submit"
                                class="w-full max-w-md bg-stone-200 hover:bg-brand-blue border-2 border-stone-300 hover:border-brand-blue text-brand-blue hover:text-white cursor-pointer text-sm font-semibold tracking-[0.14em] uppercase py-4 px-8 rounded-sm transition-all hover:shadow-lg hover:-translate-y-px active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:ring-offset-2"
                            >
                                Odeslat dokument ke zpracování
                            </button>
                            <p class="text-xs font-medium tracking-[0.1em] uppercase text-stone-400">
                                * Povinné položky
                            </p>
                        </div>

                    </form>
                )}

            </div>
        </div>
    </div>
</Layout>
