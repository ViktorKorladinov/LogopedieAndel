---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Logopedie Anděl" } = Astro.props;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link
			rel="icon"
			type="image/png"
			href="/img/favicons/favicon-32x32.png"
			sizes="32x32"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="">
		<Header />
		<div class="main relative w-full clear-both pt-[183px] md:pt-0">
			<div
				class="absolute top-0 left-0 w-full h-[500px] bg-[url('/assets/bg-main.png')] bg-repeat-x z-0"
			>
			</div>

			<div
				class="absolute top-0 left-0 w-full h-full z-10 bg-[url('/assets/bg-img-default-mobile.jpg')] md:bg-[url('/assets/bg-img-default.jpg')] lg:bg-[url('/assets/bg-img-default2.jpg')] bg-top md:bg-right-top lg:bg-top bg-no-repeat"
			>
			</div>

			<div class="max-w-[980px] mx-auto relative z-20 clear-both">
				<slot />
			</div>
		</div>
	</body>

	<Footer />
</html>
