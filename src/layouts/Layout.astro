---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
	title = "Logopedie Anděl",
	description = "Jsme specializovaná logopedická ambulance pro dospělé a děti. Nabízíme komplexní péči v Praze 5 na Andělu.",
	image = "/assets/bg-img-default.jpg",
	hideBackground = false,
} = Astro.props;

const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site || "https://www.logopedieandel.pages.dev",
);
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,600,700&display=swap&subset=latin-ext"
			rel="stylesheet"
		/>

		<!-- <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" /> -->

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content={new URL(
				image,
				Astro.site || "https://www.logopedieandel.pages.dev",
			)}
		/>

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta
			property="twitter:image"
			content={new URL(
				image,
				Astro.site || "https://www.logopedieandel.pages.dev",
			)}
		/>

		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main
			id="main-content"
			class:list={[
				"main flex-grow relative w-full clear-both",
				!hideBackground && "pt-[183px] md:pt-0",
				hideBackground && "bg-stone-100",
			]}
		>
			{
				!hideBackground && (
					<>
						<div class="absolute top-0 left-0 w-full h-[500px] bg-[url('/assets/bg-main.png')] bg-repeat-x z-0"></div>

						<div class="absolute top-0 left-0 w-full h-full z-10 bg-[url('/assets/bg-img-default-mobile.jpg')] md:bg-[url('/assets/bg-img-default.jpg')] lg:bg-[url('/assets/bg-img-default2.jpg')] bg-top md:bg-right-top lg:bg-top bg-no-repeat"></div>
					</>
				)
			}

			<div class="max-w-[980px] mx-auto relative z-20 clear-both">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
