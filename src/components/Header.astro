---

---

<header
  class="relative max-w-[980px] mx-auto h-[104px] px-5 lg:px-8 flex items-center justify-between z-[10000]"
>
  <a href="/" class="block shrink-0">
    <img
      src="/assets/logo.png"
      width="224"
      height="57"
      alt="Logopedie Anděl"
      class="logo"
    />
  </a>
  <nav
    aria-label="Hlavní navigace"
    class="hidden lg:block text-sm tracking-wide"
  >
    <ul class="flex items-center gap-6 pt-3">
      <li>
        <a
          href="/pece-pro-dospele"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >Péče pro dospělé</a
        >
      </li>
      <li>
        <a
          href="/pece-pro-deti"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >Péče pro děti</a
        >
      </li>
      <li>
        <a
          href="/o-nas"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >O nás</a
        >
      </li>
      <li>
        <a
          href="/cenik"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >Ceník</a
        >
      </li>
      <li>
        <a
          href="/kontakty"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >Kontakty</a
        >
      </li>
      <li>
        <a
          href="/nahrat"
          class="text-brand-gray font-semibold pb-1 hover:text-brand-gold transition-colors duration-100 uppercase"
          >Napsat nám</a
        >
      </li>
    </ul>
  </nav>

  <button
    class="lg:hidden text-3xl hover:text-brand-gold hover:cursor-pointer text-gray-600 font-bold p-2.5"
    id="responsivemenu"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Otevřít menu">&equiv;</button
  >

  <nav
    id="mobile-menu"
    aria-label="Mobilní navigace"
    class="hidden lg:hidden absolute top-[104px] left-0 w-full bg-white border-t border-brand-lightgray z-[100] text-sm shadow-md"
  >
    <ul class="flex flex-col">
      <li class="border-b border-brand-lightgray">
        <a
          href="/pece-pro-dospele"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >Péče pro dospělé</a
        >
      </li>
      <li class="border-b border-brand-lightgray">
        <a
          href="/pece-pro-deti"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >Péče pro děti</a
        >
      </li>
      <li class="border-b border-brand-lightgray">
        <a
          href="/o-nas"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >O nás</a
        >
      </li>
      <li class="border-b border-brand-lightgray">
        <a
          href="/cenik"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >Ceník</a
        >
      </li>
      <li class="border-b border-brand-lightgray">
        <a
          href="/kontakty"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >Kontakty</a
        >
      </li>
      <li class="border-b border-brand-lightgray">
        <a
          href="/nahrat"
          class="block py-3 px-5 text-brand-gray hover:text-brand-gold relative after:content-['►'] after:absolute after:right-4 after:top-3 uppercase"
          >Napsat nám</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById("responsivemenu");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", (e) => {
      e.preventDefault();
      mobileMenu.classList.toggle("hidden");
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!isExpanded));
      menuBtn.setAttribute(
        "aria-label",
        !isExpanded ? "Zavřít menu" : "Otevřít menu",
      );
    });
  }
</script>
