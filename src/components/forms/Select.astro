---
interface Props {
	name: string;
	label?: string;
	required?: boolean;
	className?: string;
	options: { label: string; value: string }[];
}

const { name, label, required = false, className = "", options } = Astro.props;
const inputId = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<div class={`flex flex-col gap-2 ${className}`}>
    {label && (
        <label for={inputId} class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">
            {label} {required && <span class="text-red-500">*</span>}
        </label>
    )}
    <select 
        name={name} 
        id={inputId}
        required={required} 
        aria-required={required ? "true" : undefined}
        class="w-full bg-white border-2 border-slate-300 rounded-sm px-4 py-3 text-brand-blue font-medium outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10 transition-all"
    >
        <option value=""></option>
        {options.map(opt => (
            <option value={opt.value}>{opt.label}</option>
        ))}
    </select>
</div>
