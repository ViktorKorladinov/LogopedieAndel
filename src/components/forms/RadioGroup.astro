---
interface Props {
	name: string;
	label?: string;
	options: { label: string; value: string }[];
	defaultValue?: string;
	inline?: boolean;
	className?: string;
}

const { name, label, options, defaultValue = options[0]?.value, inline = true, className = "" } = Astro.props;
---
{label ? (
    <fieldset class={`flex flex-col gap-3 h-full border-0 p-0 m-0 ${className}`}>
        <legend class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">{label}</legend>
        <div class={`flex h-full ${inline ? 'gap-x-4 gap-y-3 flex-wrap' : 'flex-col gap-2'}`}>
            {options.map(opt => (
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name={name} value={opt.value} checked={opt.value === defaultValue} class="w-5 h-5 border-slate-300 accent-brand-blue cursor-pointer shrink-0" /> 
                    <span class="text-sm font-medium text-slate-700">{opt.label}</span>
                </label>
            ))}
        </div>
    </fieldset>
) : (
    <div class={`flex flex-col gap-3 h-full ${className}`}>
        <div class={`flex h-full ${inline ? 'gap-x-4 gap-y-3 flex-wrap' : 'flex-col gap-2'}`}>
            {options.map(opt => (
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name={name} value={opt.value} checked={opt.value === defaultValue} class="w-5 h-5 border-slate-300 accent-brand-blue cursor-pointer shrink-0" /> 
                    <span class="text-sm font-medium text-slate-700">{opt.label}</span>
                </label>
            ))}
        </div>
    </div>
)}
