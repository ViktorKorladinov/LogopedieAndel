---
interface Props {
	name: string;
	label?: string;
	options: { label: string; value: string }[];
	inline?: boolean;
	className?: string;
}

const { name, label, options, inline = true, className = "" } = Astro.props;
---
<div class={`flex flex-col h-full gap-3 ${className}`}>
    {label && (
        <span class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">{label}</span>
    )}
    <div class={`flex h-full ${inline ? 'gap-4' : 'flex-col gap-2'}`}>
        {options.map(opt => (
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name={name} value={opt.value} class="w-5 h-5 border-slate-300 accent-brand-blue cursor-pointer" /> 
                <span class="text-sm font-medium text-slate-700">{opt.label}</span>
            </label>
        ))}
    </div>
</div>
