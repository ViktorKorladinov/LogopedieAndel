---
interface Props {
	name: string;
	label?: string;
	options: { label: string; value: string }[];
	layout?: 'inline' | 'column' | 'grid-2' | 'grid-3' | 'grid-4';
	inline?: boolean;
	className?: string;
}

const { name, label, options, layout, inline, className = "" } = Astro.props;

// determine layout to use (layout prop overrides inline)
const actualLayout = layout || (inline === false ? 'column' : 'inline');

let layoutClass = "";
if (actualLayout === 'grid-2') layoutClass = "grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3";
else if (actualLayout === 'grid-3') layoutClass = "grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-3";
else if (actualLayout === 'grid-4') layoutClass = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-3";
else if (actualLayout === 'column') layoutClass = "flex flex-col gap-3";
else layoutClass = "flex flex-wrap gap-x-6 gap-y-3";
---
<div class={`flex flex-col h-full gap-3 ${className}`}>
    {label && (
        <span class="text-xs font-semibold tracking-[0.14em] uppercase text-slate-500">{label}</span>
    )}
    <div class={`h-full ${layoutClass}`}>
        {options.map(opt => (
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name={name} value={opt.value} class="w-5 h-5 rounded-sm accent-brand-blue border-slate-300 focus:ring-brand-blue cursor-pointer shrink-0" /> 
                <span class="text-sm font-medium text-slate-700">{opt.label}</span>
            </label>
        ))}
    </div>
</div>
