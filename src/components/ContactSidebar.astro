---
---

<aside
    aria-label="Kontakty a ordinační hodiny"
    class="w-full md:mr-4 lg:mr-0 md:mt-[400px] lg:mt-[430px] md:w-[276px] mb-10 md:mb-24 px-5 md:px-0"
>
    <div
        class="py-4 px-5 text-white bg-brand-bluegray text-2xl flex items-center gap-4"
        aria-label="Telefonní čísla"
    >
        <svg
            viewBox="0 0 24 24"
            class="w-8 h-8 flex-shrink-0"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            ><g stroke-width="0"></g><g
                stroke-linecap="round"
                stroke-linejoin="round"></g>
            <g>
                <path
                    d="M12 18.01V18M8 3H16C17.1046 3 18 3.89543 18 5V19C18 20.1046 17.1046 21 16 21H8C6.89543 21 6 20.1046 6 19V5C6 3.89543 6.89543 3 8 3Z"
                    stroke="#ffffff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </g>
        </svg>
        <div>
            <a
                href="tel:+420735123348"
                class="block hover:text-brand-blue transition-colors"
                >+420 735 123 348</a
            >
            <a
                href="tel:+420736198769"
                class="block hover:text-brand-blue transition-colors"
                >+420 736 198 769</a
            >
        </div>
    </div>
    <a
        href="/kontakty"
        class="font-normal no-underline block hover:bg-brand-gold bg-brand-blue transition-colors"
    >
        <div class="text-white py-3 pl-5 text-base">
            <h2 class="text-2xl font-semibold m-0">Kde nás najdete?</h2>
            Ostrovského 253/3, 150 00 Praha 5
        </div>
    </a>
    <div
        class="bg-brand-brown text-white py-3 pl-5 pb-4 text-base leading-snug"
    >
        <h2 class="text-2xl pb-1 font-semibold m-0">Ordinační hodiny</h2>
        <table class="text-base leading-snug border-collapse">
            <tbody>
                <tr>
                    <th scope="row" class="pr-5 text-left font-normal w-12">PO</th>
                    <td>8:00 - 16:30</td>
                </tr>
                <tr>
                    <th scope="row" class="pr-5 text-left font-normal w-12">ÚT</th>
                    <td>10:00 - 18:30</td>
                </tr>
                <tr>
                    <th scope="row" class="pr-5 text-left font-normal w-12">ST</th>
                    <td>8:30 - 18:00</td>
                </tr>
                <tr>
                    <th scope="row" class="pr-5 text-left font-normal w-12">ČT</th>
                    <td>8:00 - 14:00</td>
                </tr>
                <tr>
                    <th scope="row" class="pr-5 text-left font-normal w-12">PÁ</th>
                    <td>8:00 - 15:30</td>
                </tr>
            </tbody>
        </table>
        <p class="pt-2">
            Přijmout lze jen po objednání telefonicky nebo e-mailem:
            <a
                href="mailto:info@logopedieandel.cz"
                class="font-bold no-underline hover:text-brand-blue"
                >info@logopedieandel.cz</a
            >
        </p>
    </div>
</aside>
